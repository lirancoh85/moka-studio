# --- AI provider ---
# "openai" or "gemini". If empty: OpenAI when OPENAI_API_KEY is set, otherwise Gemini.
AI_PROVIDER=openai

# --- OpenAI (platform.openai.com → API keys; needs billing credit) ---
OPENAI_API_KEY=
# Image model: gpt-image-2.5-sunburst is tuned for precise edits from reference photos.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Vision model for analysis and Hebrew naming.
OPENAI_TEXT_MODEL=gpt-6-luna
# low | medium | high | xhigh | max  (higher = better detail, slower, more expensive)
OPENAI_IMAGE_QUALITY=high

# --- Google Gemini (alternative provider) ---
GEMINI_API_KEY=
# Image model used for all four shots. Pro gives the best product fidelity.
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# Vision/text model for analysis and Hebrew naming.
GEMINI_TEXT_MODEL=gemini-2.5-pro
# Output resolution: 1K, 2K or 4K (4K costs more and is slower).
GEMINI_IMAGE_SIZE=2K

# --- Storage ---
# On Vercel: create a Blob store (Storage tab) and this is injected automatically.
# Leave empty locally to store files in ./.data
BLOB_READ_WRITE_TOKEN=
# "private" (recommended) or "public" — must match how the Blob store was created.
BLOB_ACCESS=private

# --- Access protection (strongly recommended on Vercel) ---
# Anyone opening the site must enter this password. Empty = no protection.
STUDIO_PASSWORD=

# --- Shopify (needed only for "Send to Shopify") ---
# Your store's myshopify domain, e.g. moka-furniture.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Option A: Dev Dashboard app (client credentials grant). Scopes: write_products, write_files
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: a legacy custom-app Admin API token (shpat_...). Used if set.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
# The Hebrew subtitle goes to the product metafield named "כותרת משנה" (found automatically).
# Only set this to force a different field (namespace.key), or "none" to skip.
SHOPIFY_SUBTITLE_METAFIELD=
# Vendor written on created products
SHOPIFY_VENDOR=MOKA
